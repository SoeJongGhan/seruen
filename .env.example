GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
DGIS_API_KEY=your_2gis_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_TABLE=user_location
SUPABASE_KEY=your_supabase_key
USER_ID=1
STT_LANGUAGE=
DGIS_TRANSPORT=driving
DGIS_SEARCH_RADIUS=3000
# Индекс устройства (0, 1, ...), RTSP/HTTP-поток или путь к видеофайлу.
# Старое имя CAMERA_INDEX тоже читается, если CAMERA_SOURCE не задан.
CAMERA_SOURCE=0
# YOLO-монитор препятствий. Веса (Research_YOLO_QolAIJol/weights/yolo26n.pt), порог
# уверенности и правило коридора берутся из Research_YOLO_QolAIJol, задавать их тут не нужно.
HAZARD_ENABLED=1
HAZARD_INTERVAL=10
# Препятствия всегда выводятся в консоль. Здесь можно дополнительно попросить копию в CSV:
# путь к файлу (относительный — от папки проекта). Пусто — файл не вести.
HAZARD_LOG=
# Показывать окно с камерой и разметкой: 1 — да, 0 — только журнал.
HAZARD_WINDOW=1
# Куда закреплена камера: chest (на груди) или head (на голове). От этого зависит
# калибровка оценки расстояния до препятствия.
HAZARD_CAMERA_MOUNT=chest
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_22050
DEFAULT_LAT=51.1283
DEFAULT_LON=71.4305
# Лента (Supabase): серверный ключ service_role / sb_secret_... — только на сервере, в браузер не попадает.
# Таблицы создаются скриптом db/schema.sql (Supabase -> SQL Editor).
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Модель модерации отзывов (Groq); при упоре в лимит проверка идёт на GROQ_CHAT_MODEL.
MODERATION_MODEL=openai/gpt-oss-safeguard-20b
